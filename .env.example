# Copy to .env (or .env.local, which takes precedence and is gitignored).
# Real environment variables override both files. Values set here also
# override ~/.brightspace-mcp/config.json written by `npm run setup`.

# ── Brightspace ──────────────────────────────────────────────────────
# Your institution's Brightspace URL. Also selects the login flow
# (e.g. brightspace.tudelft.nl → TU Delft SSO, purdue.brightspace.com → Purdue).
D2L_BASE_URL=https://brightspace.tudelft.nl

# Credentials for automated login. Leave unset to log in manually in a browser window.
D2L_USERNAME=your_username
D2L_PASSWORD=your_password

# Hide the browser during login (true/false). Required for unattended re-login on a headless host.
# D2L_HEADLESS=false

# Where the encrypted token and cookies are stored.
# D2L_SESSION_DIR=~/.d2l-session

# Seconds before a saved session is considered stale and a fresh login is forced.
# D2L_TOKEN_TTL=3600

# Course filtering — applies to all multi-course tools.
# D2L_INCLUDE_COURSES=123456,789012   # only show these course IDs
# D2L_EXCLUDE_COURSES=111111,222222   # hide these course IDs
# D2L_ACTIVE_ONLY=true                # only show active courses (default: true)

# ── Streamable HTTP server (`npm run start:http`) ─────────────────────
# Bind address. Anything other than loopback REQUIRES MCP_AUTH_TOKEN.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787

# Static bearer token clients must send as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Comma-separated host:port values accepted in the Host header (DNS-rebinding protection).
# Defaults to the loopback names; set to whatever clients use, e.g. myserver.lan:8787.
# MCP_ALLOWED_HOSTS=

# Comma-separated browser origins to accept, if any.
# MCP_ALLOWED_ORIGINS=
